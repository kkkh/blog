---
import FooterAnnouncementEntry from '@components/announcement/FooterAnnouncementEntry';
import { MAX_WIDTH } from '@constants/layout';
import { icpConfig, policeConfig, siteConfig, umamiSiteStatsConfig } from '@constants/site-config';
import { getSiteStats } from '@lib/stats';
import { cn } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import UmamiPVSpan from '@/components/umami/UmamiPVSpan';
import { getLocaleFromUrl, t } from '@/i18n';
import SakuraSVG from '../svg/SakuraSvg';

interface Props {
  className?: string;
}

const { className } = Astro.props;

const locale = getLocaleFromUrl(Astro.url.pathname);
const stats = await getSiteStats();
const currentYear = new Date().getFullYear();
const startYear = siteConfig?.startYear ?? currentYear;

/** 站点时区，用于把「运行天数」按自然日计算 */
const siteTimeZone = siteConfig?.timezone ?? 'Asia/Shanghai';
/** 建站日期，格式必须是 YYYY-MM-DD；不合法则不渲染运行天数 */
const runningSince = siteConfig?.startDate && /^\d{4}-\d{2}-\d{2}$/.test(siteConfig.startDate) ? siteConfig.startDate : null;
const runningDays = runningSince ? calendarDaysSince(runningSince, siteTimeZone) : null;
/** 供客户端脚本替换 __DAYS__ 的多语言模板 */
const runningTemplate = t(locale, 'footer.runningDays', { days: '__DAYS__' });

/** 按站点时区的自然日计算天数，建站当天记为第 1 天 */
function calendarDaysSince(dateISO: string, timeZone: string): number {
  const [year, month, day] = dateISO.split('-').map(Number);
  const start = Date.UTC(year, month - 1, day);
  const formatter = new Intl.DateTimeFormat('en-CA', {
    timeZone,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
  const parts = formatter.formatToParts(new Date());
  const pick = (type: string) => Number(parts.find((part) => part.type === type)?.value);
  const today = Date.UTC(pick('year'), pick('month') - 1, pick('day'));
  return Math.floor((today - start) / 86_400_000) + 1;
}
---

<footer class={cn('mt-auto pb-6', className)}>
  <div class={cn('mx-auto flex flex-col items-center gap-3 px-6 md:pb-10 md:px-3', MAX_WIDTH.content)}>
    <!-- Announcements Entry -->
    <FooterAnnouncementEntry client:idle />

    <!-- Site Stats -->
    <div class="text-muted-foreground flex flex-wrap items-center justify-center gap-6 text-sm md:gap-4">
      <button class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'footer.totalWordsTitle')}>
        <Icon name="ri:file-text-line" class="h-4 w-4" />
        <span class="font-medium">{stats.formattedWords}</span>
        <span class="text-xs">{t(locale, 'footer.wordUnit')}</span>
      </button>

      <div class="bg-muted-foreground/30 h-4 w-px"></div>

      <button class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'footer.readingTimeTitle')}>
        <Icon name="ri:time-line" class="h-4 w-4" />
        <span class="font-medium">{stats.formattedTime}</span>
      </button>

      <div class="bg-muted-foreground/30 h-4 w-px"></div>

      <button class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'footer.postCountTitle')}>
        <Icon name="ri:article-line" class="h-4 w-4" />
        <span class="font-medium">{stats.postCount}</span>
        <span class="text-xs">{t(locale, 'footer.postUnit')}</span>
      </button>

      {runningDays !== null && (
        <button type="button" class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100 max-[359px]:basis-full max-[359px]:justify-center" title={t(locale, 'footer.runningDaysTitle')} data-running-item="true">
          {/* 桌面端补一条分隔线；移动端隐藏，换行后由浏览量自带的分隔线接续 */}
          <span class="bg-muted-foreground/30 hidden h-4 w-px min-[769px]:block" data-running-divider="true"></span>
          <Icon name="ri:calendar-line" class="h-4 w-4" />
          <span
            class="font-medium tabular-nums"
            data-running-days="true"
            data-running-since={runningSince}
            data-running-tz={siteTimeZone}
            data-running-tpl={runningTemplate}
          >{t(locale, 'footer.runningDays', { days: runningDays })}</span>
        </button>
      )}

      {umamiSiteStatsConfig && (
        <>
          <div class="bg-muted-foreground/30 h-4 w-px"></div>
          <div class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'stats.pageviews')}>
            <Icon name="ri:eye-line" class="h-4 w-4" />
            <span class="font-medium"><UmamiPVSpan client:visible statsConfig={umamiSiteStatsConfig} /></span>
            <span class="text-xs">{t(locale, 'stats.pageviews')}</span>
          </div>
        </>
      )}

    </div>

    <!-- Copyright -->
    <div class="text-muted-foreground flex items-center gap-0.5 text-sm">
      <span class="opacity-75">©</span>
      <span class="font-medium opacity-75">{startYear}</span>
      {
        startYear !== currentYear && (
          <>
            <span class="opacity-50">-</span>
            <span class="font-medium opacity-75" itemprop="copyrightYear">
              {currentYear}
            </span>
          </>
        )
      }
      <SakuraSVG className="mx-1 size-5 animate-spin text-[#B25237] duration-10000" />
      <span class="author font-medium opacity-75" itemprop="copyrightHolder">
        {siteConfig.name}
        {siteConfig?.alternate ? `@${siteConfig.alternate}` : ''}
      </span>
    </div>

    <!-- ICP Filing -->
    {icpConfig && (
      <div class="text-muted-foreground/80 whitespace-nowrap text-xs">
        {icpConfig.link ? (
          <a href={icpConfig.link} target="_blank" rel="noopener noreferrer" class="footer-link font-medium">
            {icpConfig.text}
          </a>
        ) : (
          <span class="opacity-75">{icpConfig.text}</span>
        )}
      </div>
    )}
        <!-- 公安网备案 -->
    {policeConfig && (
      <div class="text-muted-foreground/80 whitespace-nowrap text-xs">
        <a
          href={policeConfig.link}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link inline-flex items-center gap-1 font-medium"
        >
          {policeConfig.icon && <img src={policeConfig.icon} alt="" class="h-3.5 w-3.5" />}
          {policeConfig.text}
        </a>
      </div>
    )}

    <!-- Powered By -->
    <div class="text-muted-foreground/80 flex items-center gap-2 text-xs whitespace-nowrap">
      <span class="opacity-75">基于</span>
      <a
        href="https://astro.build"
        target="_blank"
        class="footer-link font-medium transition-all duration-300"
      >
        Astro
      </a>
            <span class="opacity-75">构建</span>
      <span class="opacity-50">·</span>
      <span class="opacity-75">灵感来自</span>
      <a
        href="https://github.com/kkkh/blog"
        target="_blank"
        class="footer-link font-medium transition-all duration-300"
      >
        超超
      </a>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const DAY = 86_400_000;

    /** 按站点时区取「今天」的 UTC 日期戳，避免访客本地时区造成差一天 */
    const siteToday = (timeZone) => {
      const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).formatToParts(new Date());
      const pick = (type) => Number(parts.find((part) => part.type === type)?.value);
      return Date.UTC(pick('year'), pick('month') - 1, pick('day'));
    };

    /** 用与构建时相同的「自然日 + 站点时区」规则重算，建站当天记为第 1 天 */
    const update = () => {
      document.querySelectorAll('[data-running-days]').forEach((el) => {
        const since = el.getAttribute('data-running-since');
        const timeZone = el.getAttribute('data-running-tz') || 'Asia/Shanghai';
        const template = el.getAttribute('data-running-tpl') || '__DAYS__';
        if (!since || !/^\d{4}-\d{2}-\d{2}$/.test(since)) return;
        const [year, month, day] = since.split('-').map(Number);
        const start = Date.UTC(year, month - 1, day);
        const days = Math.floor((siteToday(timeZone) - start) / DAY) + 1;
        el.textContent = template.replace('__DAYS__', String(days));
      });
      syncDivider();
    };

    /**
     * 分隔线只在「运行天数」与前一统计项处于同一行时显示：
     * 极窄屏换行后避免行首出现孤立分隔线，平板宽度下仍与其它项保持一致。
     */
    const syncDivider = () => {
      document.querySelectorAll('[data-running-item]').forEach((item) => {
        const divider = item.querySelector('[data-running-divider]');
        const previous = item.previousElementSibling;
        if (!divider || !previous) return;
        const sameRow = Math.abs(item.getBoundingClientRect().top - previous.getBoundingClientRect().top) < 8;
        divider.style.display = sameRow ? 'block' : 'none';
      });
    };

    let timer = 0;
    /** 在站点时区的下一个 00:00 之后重新计算，并继续排下一次 */
    const schedule = () => {
      clearTimeout(timer);
      const el = document.querySelector('[data-running-days]');
      if (!el) return;
      const timeZone = el.getAttribute('data-running-tz') || 'Asia/Shanghai';
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }).formatToParts(new Date());
      const pick = (type) => Number(parts.find((part) => part.type === type)?.value);
      const elapsed = (pick('hour') * 3600 + pick('minute') * 60 + pick('second')) * 1000;
      timer = window.setTimeout(
        () => {
          update();
          schedule();
        },
        86_400_000 - elapsed + 1000,
      );
    };

    if (!document.documentElement.dataset.runningDaysInstalled) {
      document.documentElement.dataset.runningDaysInstalled = 'true';
      window.addEventListener('resize', () => requestAnimationFrame(syncDivider));
      document.fonts?.ready.then(() => syncDivider());
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) {
          update();
          schedule();
        }
      });
      document.addEventListener('astro:page-load', () => {
        update();
        schedule();
      });
      document.addEventListener('astro:before-swap', () => clearTimeout(timer));
      update();
      schedule();
    }
  })();
</script>

<style>
  .footer-link {
    opacity: 0.75;
    position: relative;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  .footer-link:hover::after {
    width: 100%;
  }

  /**
   * <360px 专用规则：
   * 极窄屏下统计项必然换行，隐藏竖分隔线，避免换行后出现行首或行末的孤立分隔线；
   * 同时把行间距收窄到 8px，让「已运行 N 天」单独占一行并居中。
   */
  @media (max-width: 359px) {
    .flex-wrap {
      row-gap: 0.5rem;
    }

    .flex-wrap > .h-4.w-px {
      display: none;
    }
  }
</style>
